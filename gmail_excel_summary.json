        "jsCode": "const rows = $input.all().map(item => item.json);\n\n// Stop without creating an email if there are no rows.\nif (rows.length === 0) {\n  return [];\n}\n\nconst details = rows.map((row, index) => {\n  return [\n    `${index + 1}. ${row.Name || 'N/A'}`,\n    `   Course: ${row.Course || 'N/A'}`,\n    `   Status: ${row.Status || 'N/A'}`\n  ].join('\\n');\n});\n\nconst subject = `Data Summary from Google Sheet - ${rows.length} Records`;\n\nconst body = [\n  'Hi,',\n  '',\n  'Here is the latest data from your Google Sheet:',\n  '',\n  ...details,\n  '',\n  'Regards,',\n  'Your Automation Bot'\n].join('\\n');\n\nreturn [{ json: { subject, body } }];"
